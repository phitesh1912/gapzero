# Copy to .env and fill in. Never commit .env.

# Supabase > Connect > Transaction pooler (port 6543). Add ?pgbouncer=true at the end.
DATABASE_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-xx.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Supabase > Connect > Session pooler or Direct connection (port 5432). Used for migrations.
DIRECT_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-xx.pooler.supabase.com:5432/postgres"

# Optional. With neither key set, AI features run in demo mode with canned responses.
GROQ_API_KEY=""
# Optional: override the Groq model (check console.groq.com for current models).
GROQ_MODEL="llama-3.3-70b-versatile"
ANTHROPIC_API_KEY=""

# Optional: protects /api/jobs/retry when run by Vercel Cron.
CRON_SECRET=""
# Optional: absolute base URL used in patient SMS links, e.g. https://gapzero.vercel.app
APP_URL=""
